{
  "expo": {
    "name": "Control Nest",
    "slug": "cnm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": "cnm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "CFBundleDisplayName": "Control Nest",
        "NSBonjourServices": ["_autopihub._tcp"],
        "NSLocalNetworkUsageDescription": "Control Nest uses the local network to discover AutoPi controllers on your Wi-Fi network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1633",
        "foregroundImage": "./assets/icon/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_LOCAL_NETWORK"
      ],
      "package": "com.tauqeerahmed.cnm"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F7F5",
          "dark": {
            "backgroundColor": "#101817",
            "image": "./assets/icon/icon.png"
          },
          "image": "./assets/icon/icon.png",
          "imageWidth": 120
        }
      ],
      "./plugins/with-android-local-network",
      "expo-font",
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      "@react-native-vector-icons/material-icons",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
